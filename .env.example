# Jeton donné par @BotFather sur Telegram
TELEGRAM_BOT_TOKEN=

# Ton identifiant Telegram (le bot te le donne au premier message si vide). Plusieurs : 123,456
ALLOWED_USER_IDS=

TIMEZONE=Europe/Paris

# Whisper local (faster-whisper). Mettre WHISPER_DEVICE=cpu et WHISPER_COMPUTE_TYPE=int8 sans GPU.
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16

# Google
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_CALENDAR_ID=primary
# Laisser vide : le bot crée le document « Notes – Assistant vocal » au premier usage
GOOGLE_NOTES_DOC_ID=

# Gmail (plusieurs adresses possibles, séparées par des virgules). La première sert aussi pour
# l'agenda, les notes et la liste de courses. Ex : perso@gmail.com, pro@gmail.com
GMAIL_ADDRESSES=

# Modèle Ollama qui comprend les demandes (il se décharge après 5 min sans demande)
OLLAMA_MODEL=qwen3.8:27b

# SMS depuis ton téléphone Android : application « SMS Gateway for Android » en mode serveur local (même Wi-Fi)
# Exemple : http://192.168.1.42:8080 (adresse affichée dans l'application)
SMS_GATEWAY_URL=
SMS_GATEWAY_USER=sms
SMS_GATEWAY_PASSWORD=

# Voix des réponses vocales (Piper) : fr_FR-siwis-medium (féminine) ou fr_FR-tom-medium (masculine)
VOICE_NAME=fr_FR-siwis-medium
# Réponses vocales : texte (par défaut, la voix ne se charge jamais), auto (vocal si tu parles en vocal) ou vocal
VOICE_REPLIES=texte
